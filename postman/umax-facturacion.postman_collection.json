          }
        }
      ]
    },
    {
      "name": "02 Series de comprobantes",
      "description": "Series (F001, B001, FC01...). Sin una serie activa no se puede emitir nada.",
      "item": [
        {
          "name": "Listar series",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/facturacion/series",
              "host": ["{{base_url}}"],
              "path": ["facturacion", "series"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const series = Array.isArray(json.data) ? json.data : [];",
                  "if (series.length) {",
                  "    pm.environment.set('serie_id', series[0].id);",
                  "    console.log('serie_id = ' + series[0].id + ' (' + series[0].serie + ')');",
                  "}",
                  "pm.test('Series listadas', function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    console.log('Total series: ' + series.length);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar serie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_documento\": \"01\",\n  \"serie\": \"F001\",\n  \"descripcion\": \"Facturas electronicas\",\n  \"limite_numeracion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/facturacion/series",
              "host": ["{{base_url}}"],
              "path": ["facturacion", "series"]
            },
            "description": "`tipo_documento`: `01` factura, `03` boleta, `07` nota de crédito.\n`serie` debe tener exactamente 4 caracteres (`F001`, `B001`, `FC01`).\n`agencia_id` es opcional."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Serie registrada (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set('serie_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar serie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Serie de prueba\",\n  \"estado\": true,\n  \"limite_numeracion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/facturacion/series/{{serie_id}}",
              "host": ["{{base_url}}"],
              "path": ["facturacion", "series", "{{serie_id}}"]
